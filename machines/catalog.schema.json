{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["digitalocean"],
  "properties": {
    "digitalocean": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "bake_class", "classes", "machines"],
      "properties": {
        "region": {
          "type": "string",
          "pattern": "^[a-z]+[0-9]+$"
        },
        "bake_class": {
          "type": "string"
        },
        "classes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sizes"],
            "properties": {
              "sizes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              }
            }
          }
        },
        "machines": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class"],
            "properties": {
              "class": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
