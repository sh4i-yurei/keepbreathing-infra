{
  "url": "https://{{ item.address }}",
  "server_certificate": "/etc/journal_pull/servers/{{ item.name }}.crt",
  "client_certificate": "/etc/journal_pull/client.crt",
  "client_key": "$CREDENTIALS_DIRECTORY/client.key",
  "output_directory": "/var/log/journal/remote/{{ item.name }}",
  "output_file": "/var/log/journal/remote/{{ item.name }}/{{ item.name }}.journal",
  "host": "{{ item.name }}",
  "gap_metric_file": "/var/lib/journal_pull/{{ item.name }}/gaps.prom"
}
