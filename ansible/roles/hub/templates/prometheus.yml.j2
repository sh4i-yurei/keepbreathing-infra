# Managed by Ansible (roles/hub). Edits here are overwritten.
global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["{{ hub_host_loopback }}:{{ hub_alertmanager_port }}"]
      basic_auth:
        username: prometheus
        password_file: /etc/prometheus/alertmanager-password

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]

  - job_name: node
    static_configs:
      - targets: ["{{ hub_host_loopback }}:9100"]
        labels:
          instance: hub

  - job_name: gatus
    static_configs:
      - targets: ["{{ hub_host_loopback }}:{{ hub_gatus_port }}"]
