# Managed by Ansible (roles/hub). Edits here are overwritten.
# Who may use Alertmanager's web interface and API (Monitoring and alerting decision #25). The
# username and bcrypt hash come from the vault item "alertmanager prometheus (hub)".
{% set alertmanager_username = lookup('vault_secret', 'alertmanager prometheus (hub)', login='username') %}
{% set alertmanager_bcrypt = lookup('vault_secret', 'alertmanager prometheus (hub)', field='bcrypt') %}
basic_auth_users:
  {{ alertmanager_username }}: "{{ alertmanager_bcrypt }}"
