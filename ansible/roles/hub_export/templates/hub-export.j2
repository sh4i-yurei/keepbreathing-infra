#!/bin/sh
# Managed by Ansible (roles/hub_export). Edits here are overwritten.
# The one command the hub's key may run, through sudo, with no arguments (Backups decisions 64 and 70).
{% if hub_export_kind == 'redis' %}
cd / && exec runuser -u {{ hub_export_container_user }} -- env XDG_RUNTIME_DIR=/run/user/{{ hub_export_container_uid }} podman exec {{ hub_export_container }} redis-cli --rdb -
{% elif hub_export_kind == 'tar' %}
cd / && exec tar -cf - {{ hub_export_tar_paths | map('quote') | join(' ') }}
{% endif %}
