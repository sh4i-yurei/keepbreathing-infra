# Managed by Ansible (roles/hub). Edits here are overwritten.
# Alerts labelled severity="page" or "critical" go to ntfy's pages topic through alertmanager-page,
# the role's copy of ntfy's alertmanager template with priority 5 (Monitoring and alerting decisions
# #14, #22, #27 and #35). severity="warning" goes to the tickets topic through ntfy's built-in
# alertmanager template, at its default priority 3. Everything else, such as info, goes to a receiver
# with no destination. Notices about the ticket band's own health, labelled band_health="true", go
# to the tickets topic first, grouped so each alert is its own notice, and never page whatever their
# severity (OpenBao on the hub decisions 24, 41 and 59). The ticket receiver is the band's pod
# behind nginx, reached through pasta's mapping of the hub's loopback and Alertmanager's password;
# no route sends to it yet (decision 76). Alerts about failed sends to it carry
# receiver_name="ticket", because Alertmanager runs with receiver-name-in-metrics, and go to the
# tickets topic next, grouped the same way, whatever their severity (decisions 29, 40 and 41). Its
# URL is written out because CI checks this template unrendered, and test_ticket_receiver_url.py
# keeps it equal to hub_host_loopback and the band's port. After the route for failed sends, alerts
# about the morning digest's failed unit, name="ticket-digest.service", go to the tickets topic,
# grouped the same way, so they never reach the ticket receiver (decisions 26, 35 and 41).
route:
  receiver: nowhere
  routes:
    - matchers:
        - band_health="true"
      receiver: ntfy-tickets
      group_by: ['...']
    - matchers:
        - receiver_name="ticket"
      receiver: ntfy-tickets
      group_by: ['...']
    - matchers:
        - name="ticket-digest.service"
      receiver: ntfy-tickets
      group_by: ['...']
    - matchers:
        - severity=~"page|critical"
      receiver: ntfy-pages
    - matchers:
        - severity="warning"
      receiver: ntfy-tickets

receivers:
  - name: nowhere
  - name: ntfy-pages
    webhook_configs:
      - url: "https://ntfy.tail4cf2f3.ts.net/pages?template=alertmanager-page"
        http_config:
          authorization:
            credentials_file: /etc/alertmanager/ntfy-token
  - name: ntfy-tickets
    webhook_configs:
      - url: "https://ntfy.tail4cf2f3.ts.net/tickets?template=alertmanager"
        http_config:
          authorization:
            credentials_file: /etc/alertmanager/ntfy-token
  - name: ticket
    webhook_configs:
      - url: "http://169.254.1.3:8083/v1/webhook"
        send_resolved: true
        http_config:
          basic_auth:
            username: alertmanager
            password_file: /etc/alertmanager/ticket-receiver-password
