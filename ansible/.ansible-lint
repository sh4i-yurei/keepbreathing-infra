---
# Imported plays that require caller variables, and files copied unchanged from upstream
# projects. The upstream files keep their formatting for byte-for-byte comparison.
exclude_paths:
  # This imported play requires become_password_hosts from its caller; lint the importing playbooks.
  - playbooks/shared/become-password.yml
  - roles/hub/files/node-mixin-rules.yml
  - roles/hub/files/node-mixin-alerts.yml
  - roles/hub/files/prometheus-mixin-alerts.yml
  - roles/hub/files/alertmanager-mixin-alerts.yml
