// Tailnet policy file for keepbreath.ing. This is the record; the admin console is the
// live copy. Edit here, then paste there, until Terraform owns that step.
//
// Machines are tagged, people are members. Tailscale SSH is the way into every tagged
// machine, as keepbreath0, in check mode: tailnet identity plus a fresh browser
// confirmation. The first grant still allows every connection; tightening it is the
// monitoring project's work, once the hub knows what it needs to reach.
{
	// Define the tags which can be applied to devices and by which users.
	// "tagOwners": {
	//   "tag:example": ["autogroup:admin"],
	// },

	// Define grants that govern access for users, groups, autogroups, tags,
	// Tailscale IP addresses, and subnet ranges.
	"grants": [
		// Allow all connections.
		// Comment this section out if you want to define specific restrictions.
		{
			"src": ["*"],
			"dst": ["*"],
			"ip":  ["*"],
		},

		// Vaultwarden: my own devices (laptop, phone), and the hub for Gatus's check of /alive.
		// Monitoring and alerting decision #31.
		{
			"src": ["autogroup:member", "tag:hub"],
			"dst": ["svc:vault"],
			"ip":  ["443"],
		},

		// ntfy: my own devices (laptop, phone), and the hub itself for the producers that
		// run on it. Notification service decision #5.
		{
			"src": ["autogroup:member", "tag:hub"],
			"dst": ["svc:ntfy"],
			"ip":  ["443"],
		},

		// Grafana: my own devices (laptop, phone). Monitoring and alerting decisions #16 and #18.
		{
			"src": ["autogroup:member"],
			"dst": ["svc:grafana"],
			"ip":  ["443"],
		},

		// node_exporter: the hub scrapes port 9100 on every machine with host metrics.
		// Monitoring and alerting decisions #26 and #30.
		{
			"src": ["tag:hub"],
			"dst": ["tag:vault", "tag:bastion", "100.116.219.6", "10.128.0.3", "10.128.0.4"],
			"ip":  ["9100"],
		},

		// Journal gateway: the hub pulls logs from every other server.
		// Monitoring and alerting decisions #36 and #56.
		{
			"src": ["tag:hub"],
			"dst": ["tag:vault", "tag:bastion", "100.116.219.6", "10.128.0.3", "10.128.0.4"],
			"ip":  ["19531"],
		},

		// Podman exporter: the hub scrapes web, control and vaultserv, as step 8h requires.
		// Monitoring and alerting decision #55.
		{
			"src": ["tag:hub"],
			"dst": ["tag:vault", "tag:bastion", "10.128.0.3"],
			"ip":  ["9882"],
		},

		// Allow users in "group:example" to access "tag:example", but only from
		// devices that are running macOS and have enabled Tailscale client auto-updating.
		// {"src": ["group:example"], "dst": ["tag:example"], "ip": ["*"], "srcPosture":["posture:autoUpdateMac"]},
	],

	// Define postures that will be applied to all rules without any specific
	// srcPosture definition.
	// "defaultSrcPosture": [
	//      "posture:anyMac",
	// ],

	// Define device posture rules requiring devices to meet
	// certain criteria to access parts of your system.
	// "postures": {
	//      // Require devices running macOS, a stable Tailscale
	//      // version and auto update enabled for Tailscale.
	//  "posture:autoUpdateMac": [
	//      "node:os == 'macos'",
	//      "node:tsReleaseTrack == 'stable'",
	//      "node:tsAutoUpdate",
	//  ],
	//      // Require devices running macOS and a stable
	//      // Tailscale version.
	//  "posture:anyMac": [
	//      "node:os == 'macos'",
	//      "node:tsReleaseTrack == 'stable'",
	//  ],
	// },

	// Define users and devices that can use Tailscale SSH.
	"ssh": [
		// Allow all users to SSH into their own devices in check mode.
		// Comment this section out if you want to define specific restrictions.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		{
			"src":    ["autogroup:member"],
			"dst":    ["tag:hub"],
			"users":  ["keepbreath0"],
			"action": "check",
		},
		{
			"src":    ["autogroup:member"],
			"dst":    ["tag:vault"],
			"users":  ["keepbreath0"],
			"action": "check",
		},
		{
			"src":    ["autogroup:member"],
			"dst":    ["tag:bastion"],
			"users":  ["keepbreath0"],
			"action": "check",
		},
	],

	"tagOwners": {
		// vault-server
		"tag:vault": ["autogroup:admin"],

		// hub-server
		"tag:hub": ["autogroup:admin"],

		// bastion-server
		"tag:bastion": ["autogroup:admin"],
	},

	// Machines tagged tag:hub are approved automatically to serve the hub's Services, so a
	// rebuilt hub comes back reachable without a click in the console. Notification service
	// decision #19; Monitoring and alerting decision #18.
	"autoApprovers": {
		"services": {
			"svc:grafana": ["tag:hub"],
			"svc:ntfy":    ["tag:hub"],
		},
	},

	"nodeAttrs": [
		{
			// Funnel policy, which lets tailnet members control Funnel
			// for their own devices.
			// Learn more at https://tailscale.com/kb/1223/tailscale-funnel/
			"target": ["autogroup:member"],
			"attr":   ["funnel"],
		},
	],

	// Test access rules every time they're saved.
	// "tests": [
	//   {
	//       "src": "alice@example.com",
	//       "accept": ["tag:example"],
	//       "deny": ["100.101.102.103:443"],
	//   },
	// ],
}
