---
# Files copied from upstream projects keep upstream's formatting for comparison.
# alertmanager-mixin-alerts.yml differs from upstream only in its two
# AlertmanagerClusterFailedToSendAlerts expressions.
exclude_paths:
  - roles/hub/files/node-mixin-rules.yml
  - roles/hub/files/node-mixin-alerts.yml
  - roles/hub/files/prometheus-mixin-alerts.yml
  - roles/hub/files/alertmanager-mixin-alerts.yml
