# Managed by Ansible (roles/hub). Edits here are overwritten.
# Grafana's data sources (Monitoring and alerting decisions #16, #39 and #41). Grafana reaches
# Prometheus and Alertmanager through the hub's loopback (decision #24). editable: false keeps the
# browser from changing them, so this file stays the record.
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    uid: prometheus
    access: proxy
    url: "http://{{ hub_host_loopback }}:{{ hub_prometheus_port }}"
    isDefault: true
    editable: false

  - name: Loki
    type: loki
    uid: loki
    access: proxy
    url: "http://{{ hub_host_loopback }}:{{ hub_loki_port }}"
    editable: false

  - name: Alertmanager
    type: alertmanager
    uid: alertmanager
    access: proxy
    url: "http://{{ hub_host_loopback }}:{{ hub_alertmanager_port }}"
    basicAuth: true
    basicAuthUser: prometheus
    jsonData:
      implementation: prometheus
      handleGrafanaManagedAlerts: false
    secureJsonData:
      basicAuthPassword: "{{ lookup('vault_secret', 'alertmanager prometheus (hub)') }}"
    editable: false

  - name: Infinity
    type: yesoreyeram-infinity-datasource
    uid: infinity
    editable: false

{% set github_fields = {
  'app_id': lookup('vault_secret', 'github app grafana (hub)', field='app_id'),
  'installation_id': lookup('vault_secret', 'github app grafana (hub)', field='installation_id'),
  'private_key': lookup('vault_secret', 'github app grafana (hub)', field='private_key')
} %}
  - name: GitHub
    type: grafana-github-datasource
    uid: github
    jsonData:
      selectedAuthType: github-app
      appId: "{{ github_fields.app_id }}"
      installationId: "{{ github_fields.installation_id }}"
    secureJsonData:
      privateKey: {{ github_fields.private_key | to_json }}
    editable: false
