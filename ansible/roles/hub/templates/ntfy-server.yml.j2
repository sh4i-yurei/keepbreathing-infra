# Managed by Ansible (roles/hub). Edits here are overwritten.
base-url: "https://ntfy.tail4cf2f3.ts.net"
listen-http: ":80"
behind-proxy: true
cache-file: "/var/lib/ntfy/cache.db"
auth-file: "/var/lib/ntfy/user.db"
auth-default-access: "deny-all"
# Metrics on their own listener, so they are never served on the Tailscale Service (decision #42).
metrics-listen-http: ":9095"

{% set ntfy_vault = {} %}
{% for user in hub_ntfy_users %}
{%   set fields = {'bcrypt': lookup('vault_secret', 'ntfy ' ~ user.name ~ ' (hub)', field='bcrypt')} %}
{%   if user.token | default(false) %}
{%     set _ = fields.update({'token': lookup('vault_secret', 'ntfy ' ~ user.name ~ ' (hub)', field='token')}) %}
{%   endif %}
{%   set _ = ntfy_vault.update({user.name: fields}) %}
{% endfor %}
auth-users:
{% for user in hub_ntfy_users %}
  - "{{ user.name }}:{{ ntfy_vault[user.name].bcrypt }}:user"
{% endfor %}

auth-access:
{% for user in hub_ntfy_users %}
{%   for rule in user.access %}
  - "{{ user.name }}:{{ rule }}"
{%   endfor %}
{% endfor %}

auth-tokens:
{% for user in hub_ntfy_users if user.token | default(false) %}
  - "{{ user.name }}:{{ ntfy_vault[user.name].token }}"
{% endfor %}
