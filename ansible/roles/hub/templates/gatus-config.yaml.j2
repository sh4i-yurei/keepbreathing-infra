# Managed by Ansible (roles/hub). Edits here are overwritten.
metrics: true

storage:
  type: sqlite
  path: /data/data.db

{% set gatus_token = lookup('vault_secret', 'ntfy gatus (hub)', field='token') %}
{% set github_token = lookup('vault_secret', 'github gatus (hub)') %}

alerting:
  ntfy:
    url: "https://ntfy.tail4cf2f3.ts.net"
    topic: pages
    token: "{{ gatus_token }}"
    priority: 5
    default-alert:
      failure-threshold: 2
      send-on-resolved: true

endpoints:
  - name: ntfy
    group: hub
    url: "https://ntfy.tail4cf2f3.ts.net/v1/health"
    interval: 1m
    conditions:
      - "[STATUS] == 200"
      - "[BODY].healthy == true"
    extra-labels:
      certificate_ticket: "true"
    alerts:
      - type: ntfy

  - name: grafana
    group: hub
    url: "https://grafana.tail4cf2f3.ts.net/api/health"
    interval: 1m
    conditions:
      - "[STATUS] == 200"
      - "[BODY].database == ok"
    extra-labels:
      certificate_ticket: "true"
    alerts:
      - type: ntfy

  # OpenBao answers 200 only when initialized, unsealed and active. This check has no Gatus alert:
  # its notice is the OpenBaoUnhealthy rule in prometheus-rules.yml, which Alertmanager's
  # band_health route sends straight to ntfy's tickets topic (OpenBao on the hub decision 59).
  - name: openbao
    group: hub
    url: "https://openbao.tail4cf2f3.ts.net/v1/sys/health"
    interval: 1m
    conditions:
      - "[STATUS] == 200"
    extra-labels:
      certificate_ticket: "true"

  - name: apex
    group: site
    url: "https://{{ hub_site_domain }}/"
    interval: 2m
    conditions:
      - "[STATUS] == 200"
    extra-labels:
      certificate_ticket: "true"
    alerts:
      - type: ntfy

  - name: www
    group: site
    url: "https://www.{{ hub_site_domain }}/"
    interval: 2m
    conditions:
      - "[STATUS] == 200"
    extra-labels:
      certificate_ticket: "true"
    alerts:
      - type: ntfy

  - name: domain-expiration
    group: site
    url: "https://{{ hub_site_domain }}/"
    interval: 24h
    conditions:
      - "[DOMAIN_EXPIRATION] > 720h"
    alerts:
      - type: ntfy

  - name: contact-form
    group: site
    url: "https://{{ hub_site_domain }}/api/challenge"
    interval: 2m
    conditions:
      - "[STATUS] == 200"
      - "len([BODY].signature) > 0"
    alerts:
      - type: ntfy

  - name: mail-submission
    group: mail
    url: "starttls://mail.{{ hub_site_domain }}:587"
    interval: 15m
    conditions:
      - "[CONNECTED] == true"
    extra-labels:
      certificate_ticket: "true"
    alerts:
      - type: ntfy

  - name: password-vault
    group: vault
    url: "https://vault.tail4cf2f3.ts.net/alive"
    interval: 2m
    conditions:
      - "[STATUS] == 200"
    extra-labels:
      certificate_ticket: "true"
    alerts:
      - type: ntfy

  - name: last-deploy
    group: github
    url: "https://api.github.com/repos/sh4i-yurei/keepbreathing/actions/workflows/deploy.yml/runs?status=completed&per_page=1"
    interval: 5m
    headers:
      Authorization: "Bearer {{ github_token }}"
      Accept: application/vnd.github+json
    conditions:
      - "[STATUS] == 200"
      - "[BODY].workflow_runs[0].conclusion == success"
    # Its notice is the GatusDeployFailed rule in prometheus-rules.yml.

  - name: deploy-queue
    group: github
    url: "https://api.github.com/repos/sh4i-yurei/keepbreathing/actions/workflows/deploy.yml/runs?status=queued&per_page=1"
    interval: 5m
    headers:
      Authorization: "Bearer {{ github_token }}"
      Accept: application/vnd.github+json
    conditions:
      - "[STATUS] == 200"
      - "[BODY].total_count == 0"
    # Its notice is the GatusDeployQueued rule in prometheus-rules.yml.

  - name: runner
    group: github
    url: "https://api.github.com/repos/sh4i-yurei/keepbreathing/actions/runners"
    interval: 5m
    headers:
      Authorization: "Bearer {{ github_token }}"
      Accept: application/vnd.github+json
    conditions:
      - "[STATUS] == 200"
      - "[BODY].runners[0].status == online"
    # Its notice is the GatusRunnerOffline rule in prometheus-rules.yml.
