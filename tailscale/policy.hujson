// Tailnet policy file for keepbreath.ing. This is the record; the admin console is the
// live copy. Edit here, then paste there, until Terraform owns that step.
//
// Machines are tagged, people are members. Tailscale SSH is the way into every tagged
// machine, as keepbreath0, in check mode: tailnet identity plus a fresh browser
// confirmation. The grants section still allows every connection; tightening it is
// the monitoring project's work, once the hub knows what it needs to reach.
{
    "tagOwners": {
        // vault-server
        "tag:vault": ["autogroup:admin"],

        // hub-server
        "tag:hub": ["autogroup:admin"],

        // bastion-server
        "tag:bastion": ["autogroup:admin"],
    },

    "grants": [
        // Allow all connections.
        {
            "src": ["*"],
            "dst": ["*"],
            "ip":  ["*"],
        },
    ],

    "ssh": [
        // Allow all users to SSH into their own devices in check mode.
        {
            "action": "check",
            "src":    ["autogroup:member"],
            "dst":    ["autogroup:self"],
            "users":  ["autogroup:nonroot", "root"],
        },
        {
            "src":    ["autogroup:member"],
            "dst":    ["tag:hub"],
            "users":  ["keepbreath0"],
            "action": "check",
        },
        {
            "src":    ["autogroup:member"],
            "dst":    ["tag:vault"],
            "users":  ["keepbreath0"],
            "action": "check",
        },
        {
            "src":    ["autogroup:member"],
            "dst":    ["tag:bastion"],
            "users":  ["keepbreath0"],
            "action": "check",
        },
    ],
}
