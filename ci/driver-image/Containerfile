# The image ci/run_driver.py runs a driver job in. It stands in for GitHub's ubuntu-26.04 runner.
# Each test account gets Ubuntu's default 65,536 subordinate IDs, as on GitHub's runner, because
# pfnet's image runs as user 65532. The first starts at 165536 in this image, because the base
# image's ubuntu user holds 100000:65536, so the openbao-client driver's bltest, blother and
# tbclient reach 362143, and the host must give its user subordinate IDs reaching past that; the
# laptop's 1,000,000 do. Nothing in this image pulls in network-online.target, so it is wanted at
# boot here, and rootless Quadlet units that wait for it start as they do on the runner.
FROM docker.io/library/ubuntu:26.04@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus sudo ca-certificates curl jq git iproute2 procps \
      nftables python3 python3-venv python3-pip uidmap \
    && rm -rf /var/lib/apt/lists/*
RUN ln -s /usr/lib/systemd/system/network-online.target \
      /etc/systemd/system/multi-user.target.wants/network-online.target
# GitHub runs steps as runner (UID 1001) with password-free sudo. runner holds no subordinate
# IDs, so they stay free for the drivers' test accounts.
RUN useradd -K SUB_UID_COUNT=0 -K SUB_GID_COUNT=0 -u 1001 -M -d /home/runner -s /bin/bash runner \
    && echo 'runner ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/runner \
    && chmod 0440 /etc/sudoers.d/runner
# Stands in for actions/setup-python: a Python on PATH that runner installs requirements into.
RUN python3 -m venv /opt/venv && chown -R runner:runner /opt/venv
ENV PATH=/opt/venv/bin:$PATH
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
