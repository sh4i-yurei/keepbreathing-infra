# Managed by Ansible (roles/node_exporter). Edits here are overwritten.
# node_exporter rereads this file on every request (exporter-toolkit's docs/web-configuration.md).
{% if node_exporter_tls %}
tls_server_config:
  cert_file: /etc/node_exporter/node_exporter.crt
  key_file: /etc/node_exporter/node_exporter.key
{% endif %}
{% if node_exporter_basic_auth_hash | length > 0 %}
basic_auth_users:
  prometheus: "{{ node_exporter_basic_auth_hash }}"
{% endif %}
