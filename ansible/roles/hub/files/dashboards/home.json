{
  "uid": "hub-home",
  "title": "Hub",
  "description": "The page Grafana opens on: firing and pending alerts, every dashboard, and whether each machine and uptime check is up.",
  "editable": false,
  "schemaVersion": 41,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "tags": [],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "alertlist",
      "title": "Alerts firing or pending",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 10 },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "groupBy": [],
        "maxItems": 20,
        "sortOrder": 3,
        "dashboardAlerts": false,
        "alertName": "",
        "alertInstanceLabelFilter": "",
        "datasource": "",
        "showInstances": true,
        "showInactiveAlerts": false,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "recovering": true,
          "noData": true,
          "error": true,
          "normal": false
        }
      }
    },
    {
      "id": 2,
      "type": "dashlist",
      "title": "Dashboards",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 10 },
      "options": {
        "showStarred": false,
        "showRecentlyViewed": false,
        "showSearch": true,
        "showHeadings": false,
        "maxItems": 20,
        "query": "",
        "tags": [],
        "includeVars": false,
        "keepTime": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Machines",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"node\"}",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uptime checks",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "gatus_results_endpoint_success",
          "legendFormat": "{{group}} / {{name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FAILING", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "justifyMode": "auto"
      }
    }
  ]
}
